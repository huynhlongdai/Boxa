# URL Boxmes Core (phía server dùng để proxy). Mặc định http://localhost:8080/v1
BOXMES_API=http://localhost:8080/v1
# Dùng khi build client (snippet hiển thị, WebSocket terminal suy ra từ đây)
NEXT_PUBLIC_BOXMES_API=http://localhost:8080/v1
# Tuỳ chọn: URL WebSocket riêng cho terminal (vd wss://boxmes.example.com/v1)
# NEXT_PUBLIC_BOXMES_WS=
# v1.10: terminal mở WebSocket thẳng tới Core bằng ticket một lần (?ticket=bxa_…, lấy qua proxy này, API key không rời server).
# Core phải cho origin của dashboard: đặt BOXMES_DASHBOARD_URL=https://<dashboard> (hoặc BOXMES_ACCESS_ORIGINS) ở phía Core.
# 1 = luôn dùng dữ liệu giả; 0 = không bao giờ; bỏ trống = tự mock khi dev mà Core không chạy
BOXMES_MOCK=1
# 1 = cho phép cookie không Secure khi chạy production qua http (chỉ dùng nội bộ)
# BOXMES_INSECURE_COOKIE=1
# v2.0: origin được phép gửi request đổi trạng thái (chống CSRF) ngoài Host của chính dashboard, cách nhau dấu phẩy
# BOXMES_DASHBOARD_ORIGINS=https://app.boxs.tech
