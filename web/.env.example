# URL Boxaz Core (phía server dùng để proxy). Mặc định http://localhost:8080/v1
BOXAZ_API=http://localhost:8080/v1
# Dùng khi build client (snippet hiển thị, WebSocket terminal suy ra từ đây)
NEXT_PUBLIC_BOXAZ_API=http://localhost:8080/v1
# Tuỳ chọn: URL WebSocket riêng cho terminal (vd wss://boxaz.example.com/v1)
# NEXT_PUBLIC_BOXAZ_WS=
# 1 = luôn dùng dữ liệu giả; 0 = không bao giờ; bỏ trống = tự mock khi dev mà Core không chạy
BOXAZ_MOCK=1
# 1 = cho phép cookie không Secure khi chạy production qua http (chỉ dùng nội bộ)
# BOXAZ_INSECURE_COOKIE=1
